FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /api ./cmd/server && CGO_ENABLED=0 go build -o /migrate ./cmd/migrate
FROM alpine:3.22
WORKDIR /app
COPY --from=build /api /migrate ./
COPY db ./db
EXPOSE 8080
CMD ["./api"]
