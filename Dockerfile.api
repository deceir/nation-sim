FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /api ./cmd/server && CGO_ENABLED=0 go build -o /migrate ./cmd/migrate && CGO_ENABLED=0 go build -o /feed ./cmd/feed
FROM alpine:3.22
WORKDIR /app
COPY --from=build /api /migrate /feed ./
COPY db ./db
EXPOSE 8080
CMD ["sh", "-c", "./migrate && ./feed && exec ./api"]
