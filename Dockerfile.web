FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
RUN npm run build
FROM nginx:1.29
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["sh", "-c", "until curl --silent --output /dev/null --connect-timeout 2 http://backend.railway.internal:8080/api/me; do echo 'Waiting for Diplomatia backend...'; sleep 2; done; echo 'Backend reachable; starting frontend.'; exec nginx -g 'daemon off;'"]
